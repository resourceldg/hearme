# Copia a .env y ajusta. Todas las variables llevan prefijo HEARME_.

# --- Rutas ---
# Dónde vive todo lo que produce el servicio. En contenedor, un volumen
# montado. Sin definir, se usa el directorio de datos estándar del sistema.
# HEARME_DATA_DIR=/var/lib/hearme
# HEARME_MODELS_DIR=

# --- Base de datos ---
# Vacío = SQLite local. Para PostgreSQL:
# HEARME_DATABASE_URL=postgresql+asyncpg://hearme:hearme@localhost/hearme

# --- Voz ---
HEARME_TTS_ENGINE=auto            # auto | kokoro | piper
HEARME_TTS_QUALITY=high           # high | draft
HEARME_NARRATION_STYLE=neutral    # neutral | novel | poetry | technical
# HEARME_TTS_VOICE=

# --- Traducción ---
# HEARME_TARGET_LANGUAGE=es
HEARME_TRANSLATOR=auto

# --- OCR ---
HEARME_OCR_ENABLED=true
HEARME_OCR_LANGUAGE=spa+eng
HEARME_OCR_CHAR_THRESHOLD=100

# --- Modo estudio (Ollama) ---
HEARME_OLLAMA_URL=http://localhost:11434
HEARME_OLLAMA_MODEL=llama3.2:3b   # 3B cuantizado: modesto en recursos

# --- Licencias ---
# Activa XTTS-v2 (CPML) y NLLB (CC-BY-NC). Solo si tu uso lo permite.
HEARME_ALLOW_NON_COMMERCIAL_MODELS=false

# --- Ejecución ---
# HEARME_MAX_WORKERS=0            # 0 = derivado de la capacidad del nodo
HEARME_API_HOST=127.0.0.1
HEARME_API_PORT=8000
HEARME_LOG_LEVEL=INFO

# Orígenes que pueden llamar a la API desde el navegador. La interfaz corre en
# otro puerto que la API, así que sin esto el navegador bloquea sus llamadas.
# Añade aquí la IP del servidor si sirves la interfaz a otros equipos de la red.
# HEARME_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# HEARME_FORCE_DEVICE=            # cpu | cuda | rocm | mps
